{
  "job_name": "minimal-cli-tool-demo",
  "jobs_dir": "jobs",
  "n_attempts": 1,
  "n_concurrent_trials": 2,
  "environment": {
    "type": "docker"
  },
  "datasets": [
    {
      "path": "tasks"
    }
  ],
  "agents": [
    {
      "name": "codex",
      "model_name": "openai/gpt-5.4",
      "env": {
        "OPENAI_API_KEY": "${OPENAI_API_KEY}"
      }
    }
  ]
}
